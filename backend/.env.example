# RetailIQ backend configuration. Copy to backend/.env (never commit it).

# --- Snowflake (analytics data, RAP-governed) ---------------------------------
SNOWFLAKE_ACCOUNT=ORG-ACCOUNT            # organization-account_name
SNOWFLAKE_USER=YOUR_SERVICE_USER         # must be granted all RETAILIQ_ROLE_* roles
SNOWFLAKE_PASSWORD=YOUR_PAT              # a Programmatic Access Token (not role-restricted)
SNOWFLAKE_DATABASE=RETAILIQ_ANALYTICS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=RETAILIQ_WH
CORTEX_AGENT_NAME=RETAILIQ_AGENT
# CORTEX_AGENT_MODEL=claude-3-5-sonnet
# Model for agreement Q&A (Cortex COMPLETE)
# CORTEX_COMPLETE_MODEL=claude-sonnet-4-5

# Role used by the data generator for DDL (needs CREATE SCHEMA/TABLE/STAGE)
# SNOWFLAKE_SETUP_ROLE=ACCOUNTADMIN

# --- Date anchor ("today" = MAX(transaction_date)) ----------------------------
# RETAILIQ_ANCHOR_PROBE_ROLE=RETAILIQ_ROLE_ADMIN
# RETAILIQ_ANCHOR_TTL_SECONDS=900

# --- Postgres (app state: users, scopes, cohorts, modules) --------------------
POSTGRES_HOST=your-instance.postgres.snowflake.app
POSTGRES_PORT=5432
POSTGRES_DB=retailiq
POSTGRES_USER=snowflake_admin
POSTGRES_PASSWORD=YOUR_PG_PASSWORD
POSTGRES_SSLMODE=verify-ca
POSTGRES_SSLROOTCERT=/absolute/path/to/instance-ca.pem

# --- Auth --------------------------------------------------------------------
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
